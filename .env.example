# Copy to .env. Use your own Beijing-region Bailian key. Never commit .env.
DASHSCOPE_API_KEY=your_dashscope_api_key_here
DASHSCOPE_MODEL=qwen3.5-flash
# China (Beijing) endpoint from the official API-key documentation.
# Free quota / stop-when-exhausted settings are controlled by your Bailian account.
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
