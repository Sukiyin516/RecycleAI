# Copy to .env. Never commit real keys. The Gemini branch uses different variables.
DASHSCOPE_API_KEY=your_dashscope_api_key_here
DASHSCOPE_MODEL=qwen3.5-flash
# Copy your region/workspace OpenAI-compatible URL from the Bailian console.
# Replace {WorkspaceId}; keys and endpoints must belong to the same region.
DASHSCOPE_BASE_URL=https://{WorkspaceId}.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
